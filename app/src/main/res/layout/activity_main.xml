<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F8F6">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_medicine_records"
        android:textSize="23sp"
        android:textStyle="bold"
        android:textColor="#176B57"
        android:gravity="center"
        android:padding="12dp" />

    <EditText
        android:id="@+id/editMedicineName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_medicine_name"
        android:inputType="textCapSentences"
        android:singleLine="true"
        android:autofillHints="none" />

    <EditText
        android:id="@+id/editDosage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_dosage"
        android:inputType="textCapSentences"
        android:singleLine="true"
        android:autofillHints="none" />

    <Button
        android:id="@+id/buttonTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_select_time" />

    <Button
        android:id="@+id/buttonSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_add_medicine"
        android:backgroundTint="#176B57"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_saved_medicines"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#176B57"
        android:paddingTop="12dp"
        android:paddingBottom="8dp" />

    <ListView
        android:id="@+id/listMedicines"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#D8E3DD"
        android:dividerHeight="1dp"
        android:padding="4dp" />

</LinearLayout>
